+  const file = join(TMP, 'unit', 'desks.json');
+  const store = new CatAssignmentStore(file);
+  assert.equal(store.merge({ desks: { a1: { desk: 's2-pink', flip: true, rear: false } } }), true);
+  for (const bad of [{ desks: [] }, { desks: { a1: { desk: 'x y', flip: true, rear: false } } }, { desks: { a1: { desk: 's1-oak', flip: 'yes', rear: false } } }, { desks: { 'a/b': { desk: 's1-oak', flip: false, rear: false } } }]) {
+    assert.equal(store.merge(bad), false, JSON.stringify(bad));
