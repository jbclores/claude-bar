+const TMP = realpathSync(mkdtempSync(join(tmpdir(), 'cat-office-places-')));
+after(() => rmSync(TMP, { recursive: true, force: true }));
+
+const { CatAssignmentStore } = await import('../../server/agent-bridge/cat-assignments.ts');
+const { buildPlaces, shouldShare } = await import('../../src/agents/live/places-share.ts');
+
+const NOW = 1_800_000_000_000;
+
+/** A place as the page posts it. */
+const place = (over: Record<string, unknown> = {}): Record<string, unknown> => ({
+  name: 'Mochi',
+  catId: 'orange',
+  floor: 2,
+  u: 0.4,
+  v: 0.6,
+  direction: 'front-left',
+  state: 'idle',
+  gesture: 'both-down',
+  expression: 'happy',
+  asleep: false,
+  activity: { kind: 'coffee', label: 'Coffee break' },
+  spotId: 'coffee-machine:0',
+  minutesLeft: 4.5,
+  phase: 'using',
+  ridingTo: null,
+  ...over,
+});
+
+type Snap = { agents: { id: string; place?: Record<string, unknown> }[]; spares?: Record<string, unknown>[]; placesAt?: number | null };
+const snap = (...ids: string[]) => ({ agents: ids.map((id) => ({ id })), repos: [], at: 1 }) as never;
