@@ -0,0 +1,94 @@
+// The cats the page shows, shared with other local apps (ClaudeBar): POST /__agents/cats keeps them in
+// <stateDir>/cat-assignments.json and every snapshot carries each agent's `cat`; <stateDir>/bridge.json tells
+// local apps where the bridge is. Unit checks of the store, then the routes on a real dev server with a temp
+// state folder and a temp Claude home holding one stand-in session (this test process's pid).
+import assert from 'node:assert/strict';
+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, statSync, writeFileSync, existsSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { after, test } from 'node:test';
+
+const TMP = realpathSync(mkdtempSync(join(tmpdir(), 'cat-office-cats-')));
+const HOME = join(TMP, 'claude');
+const STATE = join(TMP, 'state');
+process.env.CLAUDE_CONFIG_DIR = HOME;
+process.env.CAT_OFFICE_STATE_DIR = STATE;
+mkdirSync(join(HOME, 'sessions'), { recursive: true });
+after(() => rmSync(TMP, { recursive: true, force: true }));
+
+const { CatAssignmentStore, writeBridgeInfo } = await import('../../server/agent-bridge/cat-assignments.ts');
+
+test('store: merges valid assignments, refuses bad ones, keeps them across restarts', () => {
+  const file = join(TMP, 'unit', 'cat-assignments.json');
+  const store = new CatAssignmentStore(file);
+  let changes = 0;
+  store.onChange(() => changes++);
+  assert.equal(store.merge({ assignments: { a1: 'orange', 'b@2.x': 'fluffy-gray' } }), true);
+  assert.equal(store.get('a1'), 'orange');
+  assert.equal(changes, 1);
+  assert.equal(store.merge({ assignments: { a1: 'orange' } }), true);
+  assert.equal(changes, 1, 'no change, no event');
+  for (const bad of [null, {}, { assignments: [] }, { assignments: { 'a/b': 'orange' } }, { assignments: { a1: 'x y' } }, { assignments: { a1: 7 } }]) {
+    assert.equal(store.merge(bad), false, JSON.stringify(bad));
+  }
+  assert.equal(store.get('a1'), 'orange', 'a refused body changes nothing');
+  assert.equal(new CatAssignmentStore(file).get('b@2.x'), 'fluffy-gray');
+  const snap = { agents: [{ id: 'a1' }, { id: 'zz' }], repos: [], at: 1 } as never;
+  const applied = store.apply(snap) as { agents: { id: string; cat?: string }[] };
+  assert.equal(applied.agents[0].cat, 'orange');
+  assert.equal('cat' in applied.agents[1], false);
+});
+
+test('bridge info: owner-only file, removed only by its own process', () => {
+  const file = join(TMP, 'unit', 'bridge.json');
+  const remove = writeBridgeInfo(file, 'http://localhost:5173', 'tok');
+  assert.deepEqual(JSON.parse(readFileSync(file, 'utf8')), { url: 'http://localhost:5173', token: 'tok', pid: process.pid });
+  assert.equal(statSync(file).mode & 0o777, 0o600);
+  remove();
+  assert.equal(existsSync(file), false);
+  writeFileSync(file, JSON.stringify({ url: 'x', token: 't', pid: 1 }));
+  remove();
+  assert.equal(existsSync(file), true, "another server's file stays");
+});
+
+test('routes: POST /__agents/cats, `cat` in snapshots, bridge.json while serving', { timeout: 60_000 }, async () => {
+  const sessionId = '11111111-2222-3333-4444-555555555555';
+  const cwd = join(TMP, 'project');
+  mkdirSync(cwd, { recursive: true });
+  writeFileSync(join(HOME, 'sessions', `${process.pid}.json`), JSON.stringify({ pid: process.pid, sessionId, cwd, startedAt: Date.now(), kind: 'interactive', status: 'idle', name: 'stand-in' }));
+  const { createServer } = await import('vite');
+  const { agentBridge } = await import('../../server/agent-bridge/index.ts');
+  const root = join(TMP, 'site');
+  mkdirSync(root, { recursive: true });
+  writeFileSync(join(root, 'index.html'), '<!doctype html><title>t</title>');
+  const server = await createServer({ configFile: false, root, logLevel: 'silent', server: { port: 0, host: '127.0.0.1', hmr: false, watch: null }, plugins: [agentBridge()] });
+  await server.listen();
+  const bridgeFile = join(STATE, 'bridge.json');
+  try {
+    const addr = server.httpServer!.address() as { port: number };
+    const base = `http://localhost:${addr.port}`;
+    const token = /__CAT_OFFICE_TOKEN__\s*=\s*"([^"]+)"/.exec(await (await fetch(`${base}/`)).text())?.[1] ?? '';
+    assert.ok(token);
+    const info = JSON.parse(readFileSync(bridgeFile, 'utf8'));
+    assert.deepEqual(info, { url: base, token, pid: process.pid });
+    assert.equal(statSync(bridgeFile).mode & 0o777, 0o600);
+
+    const post = (body: unknown, headers: Record<string, string> = { 'x-cat-office-token': token }) =>
+      fetch(`${base}/__agents/cats`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...headers }, body: JSON.stringify(body) });
+    assert.equal((await post({ assignments: {} }, {})).status, 401, 'no token');
+    assert.equal((await post({ assignments: {} }, { 'x-cat-office-token': token, Origin: 'http://evil.example' })).status, 403, 'another origin');
+    assert.equal((await fetch(`${base}/__agents/cats`, { headers: { 'x-cat-office-token': token } })).status, 405);
+    assert.equal((await post({ assignments: { [sessionId]: 'not a cat!' } })).status, 400);
+
+    const agents = async () => ((await (await fetch(`${base}/__agents`, { headers: { 'x-cat-office-token': token } })).json()).agents as { id: string; cat?: string }[]);
+    const deadline = Date.now() + 15_000;
+    while (!(await agents()).some((a) => a.id === sessionId) && Date.now() < deadline) await new Promise((r) => setTimeout(r, 200));
+    assert.ok((await agents()).some((a) => a.id === sessionId), 'the stand-in session shows up');
+    assert.equal((await post({ assignments: { [sessionId]: 'tuxedo' } })).status, 200);
+    assert.equal((await agents()).find((a) => a.id === sessionId)?.cat, 'tuxedo');
+    assert.deepEqual(JSON.parse(readFileSync(join(STATE, 'cat-assignments.json'), 'utf8')).cats, { [sessionId]: 'tuxedo' });
+  } finally {
+    await server.close();
+  }
+  assert.equal(existsSync(bridgeFile), false, 'bridge.json goes with the server');
+});
