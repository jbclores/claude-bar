+  writeFileSync(join(root, 'index.html'), '<!doctype html><title>t</title>');
+  const server = await createServer({ configFile: false, root, logLevel: 'silent', server: { port: 0, host: '127.0.0.1', hmr: false, watch: null }, plugins: [agentBridge()] });
+  await server.listen();
+  const bridgeFile = BRIDGE_FILE;
+  try {
+    const addr = server.httpServer!.address() as { port: number };
+    const base = `http://localhost:${addr.port}`;
+    const token = /__CAT_OFFICE_TOKEN__\s*=\s*"([^"]+)"/.exec(await (await fetch(`${base}/`)).text())?.[1] ?? '';
+    assert.ok(token);
+    const info = JSON.parse(readFileSync(bridgeFile, 'utf8'));
+    assert.deepEqual(info, { url: base, token, dir: root, pid: process.pid });
+    assert.equal(statSync(bridgeFile).mode & 0o777, 0o600);
+
+    const post = (body: unknown, headers: Record<string, string> = { 'x-cat-office-token': token }) =>
+      fetch(`${base}/__agents/cats`, { method: 'POST', headers: { 'Content-Type': 'application/json', ...headers }, body: JSON.stringify(body) });
+    assert.equal((await post({ assignments: {} }, {})).status, 401, 'no token');
+    assert.equal((await post({ assignments: {} }, { 'x-cat-office-token': token, Origin: 'http://evil.example' })).status, 403, 'another origin');
+    assert.equal((await fetch(`${base}/__agents/cats`, { headers: { 'x-cat-office-token': token } })).status, 405);
+    assert.equal((await post({ assignments: { [sessionId]: 'not a cat!' } })).status, 400);
+
+    const agents = async () => ((await (await fetch(`${base}/__agents`, { headers: { 'x-cat-office-token': token } })).json()).agents as { id: string; cat?: string }[]);
+    const deadline = Date.now() + 15_000;
+    while (!(await agents()).some((a) => a.id === sessionId) && Date.now() < deadline) await new Promise((r) => setTimeout(r, 200));
+    assert.ok((await agents()).some((a) => a.id === sessionId), 'the stand-in session shows up');
+    assert.equal((await post({ assignments: { [sessionId]: 'tuxedo' } })).status, 200);
+    assert.equal((await agents()).find((a) => a.id === sessionId)?.cat, 'tuxedo');
+    assert.deepEqual(JSON.parse(readFileSync(join(STATE, 'cat-assignments.json'), 'utf8')).cats, { [sessionId]: 'tuxedo' });
+  } finally {
+    await server.close();
+  }
+  assert.equal(existsSync(bridgeFile), false, 'bridge.json goes with the server');
+});
