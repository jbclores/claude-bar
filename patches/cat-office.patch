+/**
+ * The cat the page shows for each agent (POST /__agents/cats), kept in <stateDir>/cat-assignments.json by agent
+ * id, so other local apps (ClaudeBar's menu bar office) show the same cats. Every snapshot carries an agent's
+ * `cat` once the page has given it one. Also: ~/.cat-office/bridge.json, telling those apps where the bridge is
+ * and which folder Cat Office runs from (so they find it after the folder moves).
+ */
+import { chmodSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+import type { AgentSnapshot } from './types.ts';
+
+/**
+ * Where local apps look for the running bridge: ~/.cat-office/bridge.json. A server on another state folder
+ * (CAT_OFFICE_STATE_DIR: the tests) keeps it there instead, so it never takes over the real one;
+ * CAT_OFFICE_BRIDGE_FILE overrides both.
+ */
+export function bridgeFile(env: NodeJS.ProcessEnv = process.env, home: string = homedir()): string {
+  if (env.CAT_OFFICE_BRIDGE_FILE) return env.CAT_OFFICE_BRIDGE_FILE;
+  if (env.CAT_OFFICE_STATE_DIR) return join(env.CAT_OFFICE_STATE_DIR, 'bridge.json');
+  return join(home, '.cat-office', 'bridge.json');
+}
+
+const ID = /^[\w@.-]{1,128}$/;
+const CAT = /^[\w-]{1,64}$/;
+/** The file keeps at most this many agents; the oldest go first. */
+const KEEP_MAX = 2000;
+
+type ChangeListener = () => void;
+
+export class CatAssignmentStore {
+  private cats = new Map<string, string>();
+  private listeners = new Set<ChangeListener>();
+  readonly file: string;
+
+  constructor(file: string) {
+    this.file = file;
+    this.load();
+  }
+
+  onChange(fn: ChangeListener): () => void {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+
+  get(id: string): string | null {
+    return this.cats.get(id) ?? null;
+  }
+
+  /** Takes the page's `{ assignments: { [agentId]: catId } }`. False for a bad body (nothing kept) or a failed save. */
+  merge(body: unknown): boolean {
+    const raw = (body as { assignments?: unknown } | null)?.assignments;
+    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return false;
+    const entries = Object.entries(raw as Record<string, unknown>);
+    if (!entries.every(([id, cat]) => ID.test(id) && typeof cat === 'string' && CAT.test(cat))) return false;
+    let changed = false;
+    for (const [id, cat] of entries as [string, string][]) {
+      if (this.cats.get(id) === cat) continue;
+      this.cats.delete(id); // re-inserted last: the newest
+      this.cats.set(id, cat);
+      changed = true;
+    }
+    while (this.cats.size > KEEP_MAX) this.cats.delete(this.cats.keys().next().value as string);
+    if (!changed) return true;
+    try {
+      this.save();
+    } catch {
+      return false;
+    }
+    for (const fn of this.listeners) {
+      try {
+        fn();
+      } catch {
+        // A broken listener must not stop the others.
+      }
+    }
+    return true;
+  }
+
+  /** The snapshot with each agent's cat, for the agents the page has given one. */
+  apply(snapshot: AgentSnapshot): AgentSnapshot {
+    return {
+      ...snapshot,
+      agents: snapshot.agents.map((a) => {
+        const cat = this.cats.get(a.id);
+        return cat ? { ...a, cat } : a;
+      }),
+    };
+  }
+
+  private load(): void {
+    try {
+      const d = JSON.parse(readFileSync(this.file, 'utf8')) as { cats?: Record<string, unknown> };
+      for (const [id, cat] of Object.entries(d.cats ?? {})) {
+        if (ID.test(id) && typeof cat === 'string' && CAT.test(cat)) this.cats.set(id, cat);
+      }
+    } catch {
+      // None yet (or unreadable): start empty.
+    }
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.file), { recursive: true });
+    const tmp = `${this.file}.tmp`;
+    writeFileSync(tmp, JSON.stringify({ cats: Object.fromEntries(this.cats) }, null, 2) + '\n');
+    renameSync(tmp, this.file);
+  }
+}
+
+/**
+ * Writes `{ url, token, dir, pid }` to `file` (owner-only: it holds the token) for local apps to find the bridge
+ * and Cat Office's folder. Returns a remover that deletes it, unless another server has written its own since.
+ */
+export function writeBridgeInfo(file: string, info: { url: string; token: string; dir: string }): () => void {
+  mkdirSync(dirname(file), { recursive: true });
+  const tmp = `${file}.tmp`;
+  writeFileSync(tmp, JSON.stringify({ url: info.url, token: info.token, dir: info.dir, pid: process.pid }) + '\n', { mode: 0o600 });
+  chmodSync(tmp, 0o600);
+  renameSync(tmp, file);
+  return () => {
+    try {
+      const d = JSON.parse(readFileSync(file, 'utf8')) as { pid?: unknown };
+      if (d.pid === process.pid) rmSync(file);
+    } catch {
+      // Already gone.
+    }
+  };
+}
