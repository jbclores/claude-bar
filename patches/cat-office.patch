+import { useEffect, useRef } from 'react';
+import { activityFor, type ActivityKind } from '../../simulation/activities';
+import type { SimulationEngine } from '../../simulation/simulation-engine';
+import type { AgentPhaseLabel, SimSnapshot } from '../../simulation/simulation.types';
+import type { FloorId, Spot } from '../../world/world.types';
+import { post } from './actions';
+
+/*
+ * Where each cat is and what it's doing, shared with other local apps (ClaudeBar's menu bar office mirrors it):
+ * every 2 s while it is shown, the page posts every cat's place to the bridge (POST /__agents/cats
+ * `{ places, at, page }`, `page` this page load's id: the bridge follows one page when several are shown), keyed by the live session its cat stands for, or `spare:<sim id>` for a spare cat. The bridge
+ * keeps them in memory only (server/agent-bridge/cat-assignments.ts) and every snapshot carries them.
+ */
+
+/** What the other apps draw from: the engine's snapshot (simulation-engine.ts snapshot()), flattened. */
+export interface SharedPlace {
+  /** The cat's own name. */
+  name: string;
+  /** Its sprite set (cats.json). */
+  catId: string;
+  floor: FloorId;
+  u: number;
+  v: number;
+  direction: string;
+  /** CatState (agent.types.ts). */
+  state: string;
+  gesture: string;
+  expression: string;
+  /** A nap (activities.ts `asleep`, or a spot's sleeping pose). */
+  asleep: boolean;
+  /**
+   * `kind`: the spot's activity kind (activities.ts) while the cat is at one; 'elevator' riding; else 'other'
+   * (a badge with no spot: a meeting without a table, a fire). `label`: the badge the page shows.
+   */
+  activity: { kind: string; label: string } | null;
+  /** The spot the cat is at (after arriving), or null while walking or standing. */
+  spotId: string | null;
+  /**
+   * Sim minutes left at the spot, rounded up to whole minutes (as the page shows them, CatInspector.tsx), or null.
+   * Whole minutes keep a still cat's place the same between posts, so the bridge only broadcasts on change.
+   */
+  minutesLeft: number | null;
+  phase: 'walking' | 'using' | 'elevator' | 'idle';
+  /** The floor the elevator takes it to, or null. */
+  ridingTo: FloorId | null;
+}
+
+/** The engine's phase labels (simulation.types.ts) as shared: deciding and waiting are standing about. */
+const PHASES: Record<AgentPhaseLabel, SharedPlace['phase']> = {
+  walking: 'walking',
+  using: 'using',
+  elevator: 'elevator',
+  deciding: 'idle',
+  waiting: 'idle',
+};
+
+interface FloorsWithSpots {
+  floors: readonly { id: FloorId; spots: readonly Spot[] }[];
+}
+
+const finite = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n);
+
+/**
+ * Every cat's place: a session's cat under its live agent id (agentOf: sim id → session, useAgentCats), the rest
+ * under `spare:<sim id>`. `building` (the engine's) names the spot each cat is at, for its activity's kind and
+ * whether it is a nap. A cat with a non-finite position is left out.
+ */
+export function buildPlaces(snapshot: Pick<SimSnapshot, 'agents'>, agentOf: ReadonlyMap<string, { id: string }>, building?: FloorsWithSpots): Record<string, SharedPlace> {
+  const out: Record<string, SharedPlace> = {};
+  for (const a of snapshot.agents) {
+    if (!finite(a.position.u) || !finite(a.position.v)) continue;
+    const spot = a.usingSpotId ? building?.floors.find((f) => f.id === a.floor)?.spots.find((s) => s.id === a.usingSpotId) : undefined;
+    const def = spot && spot.kind !== 'elevator' ? activityFor(spot) : null;
+    const phase = PHASES[a.phase] ?? 'idle';
+    const kind: ActivityKind | 'elevator' | 'other' = def ? def.kind : phase === 'elevator' ? 'elevator' : 'other';
+    out[agentOf.get(a.id)?.id ?? `spare:${a.id}`] = {
+      name: a.name,
+      catId: a.catId,
+      floor: a.floor,
+      u: a.position.u,
+      v: a.position.v,
+      direction: a.direction,
+      state: a.state,
+      gesture: a.gesture,
+      expression: a.expression,
+      asleep: def?.asleep === true || a.pose === 'sleep',
+      activity: a.activity ? { kind, label: a.activity.label } : null,
+      spotId: a.usingSpotId,
+      minutesLeft: finite(a.minutesLeft) ? Math.ceil(a.minutesLeft) : null,
+      phase,
+      ridingTo: a.ridingTo,
+    };
+  }
+  return out;
+}
+
+const SHARE_EVERY_MS = 2000;
+
+/** This page load's id, sent with every post (the bridge follows one page's places at a time). */
+const PAGE_ID = `page-${Math.random().toString(36).slice(2, 12)}-${Date.now().toString(36)}`;
+
+/**
+ * Whether the page should share now: only while it is shown. The engine steps on requestAnimationFrame, which
+ * browsers pause in hidden tabs, so a hidden page's office is frozen and must not be posted as live.
+ */
+export const shouldShare = (visibility: string): boolean => visibility === 'visible';
+
+/**
+ * Posts buildPlaces every 2 s while `on` (live data) and the page is shown (shouldShare), and at once when it is
+ * shown again. agentOf is read when posting, so a new map doesn't restart the timer.
+ */
+export function usePlacesShare(engine: SimulationEngine, agentOf: ReadonlyMap<string, { id: string }>, on: boolean): void {
+  const latest = useRef(agentOf);
+  useEffect(() => {
+    latest.current = agentOf;
+  }, [agentOf]);
+  useEffect(() => {
+    if (!on) return undefined;
+    let busy = false;
+    const share = (): void => {
+      if (busy || !shouldShare(document.visibilityState)) return;
+      busy = true;
+      const places = buildPlaces(engine.snapshot(), latest.current, engine.building);
+      void post('/__agents/cats', { places, at: Date.now(), page: PAGE_ID }, () => true).finally(() => {
+        busy = false;
+      });
+    };
+    const timer = window.setInterval(share, SHARE_EVERY_MS);
+    document.addEventListener('visibilitychange', share);
+    return () => {
+      window.clearInterval(timer);
+      document.removeEventListener('visibilitychange', share);
+    };
+  }, [engine, on]);
+}
