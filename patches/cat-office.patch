+import { useEffect, useRef } from 'react';
+import type { FloorId } from '../../world/world.types';
+import { reportDesks } from './actions';
+import type { LiveSource } from './useLiveAgents';
+
+/**
+ * Which desk each live session's cat works at (design, mirrored, turned), reported to the bridge (POST
+ * /__agents/cats) so other local apps (ClaudeBar's menu bar office) draw the same desk.
+ */
+export interface DeskReport {
+  /** Catalogue id (public/data/desks.json). */
+  desk: string;
+  flip: boolean;
+  rear: boolean;
+}
+
+interface CatsAndDesks {
+  agents: readonly { id: string; floor: FloorId; usingSpotId: string | null }[];
+  homeDesk: (catId: string, floor: FloorId) => string | null;
+}
+
+interface FloorsWithDesks {
+  floors: readonly { id: FloorId; room?: { desks?: readonly { id: string; desk: string; flip?: boolean; rear?: boolean }[] } }[];
+}
+
+/** The desk the cat is at, else the one it works at on its floor; null when it has none there. */
+export function deskOf(engine: CatsAndDesks, building: FloorsWithDesks, catId: string): DeskReport | null {
+  const cat = engine.agents.find((a) => a.id === catId);
+  if (!cat) return null;
+  const desks = building.floors.find((f) => f.id === cat.floor)?.room?.desks ?? [];
+  const at = cat.usingSpotId ? desks.find((d) => d.id === cat.usingSpotId) : undefined;
+  const placement = at ?? desks.find((d) => d.id === engine.homeDesk(catId, cat.floor));
+  return placement ? { desk: placement.desk, flip: placement.flip === true, rear: placement.rear === true } : null;
+}
+
+/** Session id → its cat's desk, for the sessions whose cat has one. */
+export function deskReports(engine: CatsAndDesks, building: FloorsWithDesks, agentOf: ReadonlyMap<string, { id: string }>): Record<string, DeskReport> {
+  const out: Record<string, DeskReport> = {};
+  for (const [catId, agent] of agentOf) {
+    const desk = deskOf(engine, building, catId);
+    if (desk) out[agent.id] = desk;
+  }
+  return out;
+}
+
+/** Desks change as cats move between floors and desks (not as React renders): looked at every few seconds. */
+const CHECK_MS = 3000;
+
+/** Reports deskReports to the bridge whenever it changes (live data only). */
+export function useReportDesks(engine: CatsAndDesks, building: FloorsWithDesks, agentOf: ReadonlyMap<string, { id: string }>, source: LiveSource): void {
+  const reported = useRef('');
+  useEffect(() => {
+    if (source !== 'live') return;
+    const check = (): void => {
+      const desks = deskReports(engine, building, agentOf);
+      const body = JSON.stringify(desks);
+      if (body === reported.current || Object.keys(desks).length === 0) return;
+      void reportDesks(desks).then((r) => {
+        if (r.ok) reported.current = body;
+      });
+    };
+    check();
+    const timer = window.setInterval(check, CHECK_MS);
+    return () => window.clearInterval(timer);
+  }, [engine, building, agentOf, source]);
+}
