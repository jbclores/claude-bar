+  const store = new CatAssignmentStore(join(TMP, 'a', 'cats.json'));
+  let changes = 0;
+  store.onChange(() => changes++);
+  assert.equal(store.merge({ places: { s1: place() }, at: NOW - 1000 }, NOW), true);
+  assert.equal(changes, 1, 'new places go out to the stream');
+  const out = store.apply(snap('s1', 's2'), NOW) as unknown as Snap;
+  const { name: _name, ...rest } = place();
+  assert.deepEqual(out.agents[0].place, { ...rest, at: NOW - 1000 });
+  assert.equal('place' in out.agents[1], false, 'no place: none attached');
+  assert.deepEqual(out.spares, []);
+  assert.equal(out.placesAt, NOW - 1000);
+});
+
+test('places: never written to disk', () => {
+  const file = join(TMP, 'b', 'cats.json');
