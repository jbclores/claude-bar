+// The cats the page shows, shared with other local apps (ClaudeBar): POST /__agents/cats keeps them in
+// <stateDir>/cat-assignments.json and every snapshot carries each agent's `cat`; ~/.cat-office/bridge.json tells
+// local apps where the bridge (and this folder) is. Unit checks of the store, then the routes on a real dev server with a temp
+// state folder, a temp bridge file and a temp Claude home holding one stand-in session (this test's pid).
+import assert from 'node:assert/strict';
+import { mkdirSync, mkdtempSync, readFileSync, realpathSync, rmSync, statSync, writeFileSync, existsSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { after, test } from 'node:test';
+
+const TMP = realpathSync(mkdtempSync(join(tmpdir(), 'cat-office-cats-')));
+const HOME = join(TMP, 'claude');
+const STATE = join(TMP, 'state');
+process.env.CLAUDE_CONFIG_DIR = HOME;
+process.env.CAT_OFFICE_STATE_DIR = STATE;
+const BRIDGE_FILE = join(TMP, 'home', '.cat-office', 'bridge.json');
+process.env.CAT_OFFICE_BRIDGE_FILE = BRIDGE_FILE;
+mkdirSync(join(HOME, 'sessions'), { recursive: true });
+after(() => rmSync(TMP, { recursive: true, force: true }));
+
+const { bridgeFile, CatAssignmentStore, writeBridgeInfo } = await import('../../server/agent-bridge/cat-assignments.ts');
+
+test('bridge file: home by default, never there for a test or other state folder', () => {
+  assert.equal(bridgeFile({ HOME: '/h' }, '/h'), '/h/.cat-office/bridge.json');
+  assert.equal(bridgeFile({ CAT_OFFICE_STATE_DIR: '/tmp/s' }, '/h'), '/tmp/s/bridge.json');
+  assert.equal(bridgeFile({ CAT_OFFICE_STATE_DIR: '/tmp/s', CAT_OFFICE_BRIDGE_FILE: '/x/b.json' }, '/h'), '/x/b.json');
+});
+
+test('store: a failed save answers false instead of throwing', () => {
+  const blocker = join(TMP, 'not-a-dir');
+  writeFileSync(blocker, 'x');
+  const store = new CatAssignmentStore(join(blocker, 'cat-assignments.json'));
+  assert.equal(store.merge({ assignments: { a1: 'orange' } }), false);
+});
+
+test('store: merges valid assignments, refuses bad ones, keeps them across restarts', () => {
+  const file = join(TMP, 'unit', 'cat-assignments.json');
+  const store = new CatAssignmentStore(file);
+  let changes = 0;
+  store.onChange(() => changes++);
+  assert.equal(store.merge({ assignments: { a1: 'orange', 'b@2.x': 'fluffy-gray' } }), true);
+  assert.equal(store.get('a1'), 'orange');
+  assert.equal(changes, 1);
+  assert.equal(store.merge({ assignments: { a1: 'orange' } }), true);
+  assert.equal(changes, 1, 'no change, no event');
+  for (const bad of [null, {}, { assignments: [] }, { assignments: { 'a/b': 'orange' } }, { assignments: { a1: 'x y' } }, { assignments: { a1: 7 } }]) {
+    assert.equal(store.merge(bad), false, JSON.stringify(bad));
+  }
+  assert.equal(store.get('a1'), 'orange', 'a refused body changes nothing');
+  assert.equal(new CatAssignmentStore(file).get('b@2.x'), 'fluffy-gray');
+  const snap = { agents: [{ id: 'a1' }, { id: 'zz' }], repos: [], at: 1 } as never;
+  const applied = store.apply(snap) as { agents: { id: string; cat?: string }[] };
+  assert.equal(applied.agents[0].cat, 'orange');
+  assert.equal('cat' in applied.agents[1], false);
+});
+
+test('bridge info: owner-only file, removed only by its own process', () => {
+  const file = join(TMP, 'unit', 'bridge.json');
+  const remove = writeBridgeInfo(file, { url: 'http://localhost:5173', token: 'tok', dir: '/x/cat-office' });
+  assert.deepEqual(JSON.parse(readFileSync(file, 'utf8')), { url: 'http://localhost:5173', token: 'tok', dir: '/x/cat-office', pid: process.pid });
+  assert.equal(statSync(file).mode & 0o777, 0o600);
+  remove();
+  assert.equal(existsSync(file), false);
+  writeFileSync(file, JSON.stringify({ url: 'x', token: 't', pid: 1 }));
+  remove();
+  assert.equal(existsSync(file), true, "another server's file stays");
+});
+
+test('routes: POST /__agents/cats, `cat` in snapshots, bridge.json while serving', { timeout: 60_000 }, async () => {
+  const sessionId = '11111111-2222-3333-4444-555555555555';
+  const cwd = join(TMP, 'project');
+  mkdirSync(cwd, { recursive: true });
+  writeFileSync(join(HOME, 'sessions', `${process.pid}.json`), JSON.stringify({ pid: process.pid, sessionId, cwd, startedAt: Date.now(), kind: 'interactive', status: 'idle', name: 'stand-in' }));
+  const { createServer } = await import('vite');
