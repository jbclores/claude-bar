+/**
+ * The cat the page shows for each agent, and the desk that cat works at (POST /__agents/cats), kept in
+ * <stateDir>/cat-assignments.json by agent id, so other local apps (ClaudeBar's menu bar office) show the same
+ * cats at the same desks. Every snapshot carries an agent's `cat` and `desk` once the page has reported them. Also: ~/.cat-office/bridge.json, telling those apps where the bridge is
+ * and which folder Cat Office runs from (so they find it after the folder moves).
+ *
+ * Where each cat is and what it's doing (`places`, posted every 2 s by src/agents/live/places-share.ts) is kept in
+ * memory only: each snapshot carries an agent's `place`, the spare cats' places as `spares`, and the newest `at`
+ * as `placesAt`, so those apps mirror the page's office while it is open.
+ */
+import { chmodSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { homedir } from 'node:os';
+import { dirname, join } from 'node:path';
+import type { AgentSnapshot, CatPlace, SparePlace } from './types.ts';
+
+/**
+ * Where local apps look for the running bridge: ~/.cat-office/bridge.json. A server on another state folder
+ * (CAT_OFFICE_STATE_DIR: the tests) keeps it there instead, so it never takes over the real one;
+ * CAT_OFFICE_BRIDGE_FILE overrides both.
+ */
+export function bridgeFile(env: NodeJS.ProcessEnv = process.env, home: string = homedir()): string {
+  if (env.CAT_OFFICE_BRIDGE_FILE) return env.CAT_OFFICE_BRIDGE_FILE;
+  if (env.CAT_OFFICE_STATE_DIR) return join(env.CAT_OFFICE_STATE_DIR, 'bridge.json');
+  return join(home, '.cat-office', 'bridge.json');
+}
+
+const ID = /^[\w@.-]{1,128}$/;
+const CAT = /^[\w-]{1,64}$/;
+/** The file keeps at most this many agents; the oldest go first. */
+const KEEP_MAX = 2000;
+/** A spare cat's place key: `spare:<simulation id>`. */
+const SPARE = /^spare:([\w@.-]{1,128})$/;
+/** Places kept at most (the oldest go first), and for at most this long. */
+const PLACES_MAX = 500;
+const PLACE_MAX_AGE_MS = 60_000;
+/** Snapshots show only the latest round of places: within this of the newest (pages post every 2 s). */
+const PLACE_ROUND_MS = 5000;
+/** A post further ahead of the server's clock than this is refused (it would pin the mirror live). */
+const PLACE_AHEAD_MS = 5000;
+/** Unchanged places still go out to the stream this often while posts keep coming (ClaudeBar's 10 s liveness). */
+const PLACE_HEARTBEAT_MS = 5000;
+/**
+ * With several pages shown, each runs its own office (the same keys, cats in different places). The bridge follows
+ * one page, the first that posted, and ignores the others' places until it has been silent this long.
+ */
+const PAGE_SILENT_MS = 5000;
+
+type ChangeListener = () => void;
+
+/** A desk as the page reports it: catalogue id, mirrored, turned (drawn from the rear). */
+export interface AgentDesk {
+  id: string;
+  flip: boolean;
+  rear: boolean;
+}
+
+function readDesk(v: unknown): AgentDesk | null {
+  if (!v || typeof v !== 'object') return null;
+  const d = v as { desk?: unknown; id?: unknown; flip?: unknown; rear?: unknown };
+  const id = typeof d.desk === 'string' ? d.desk : d.id;
+  if (typeof id !== 'string' || !CAT.test(id) || typeof d.flip !== 'boolean' || typeof d.rear !== 'boolean') return null;
+  return { id, flip: d.flip, rear: d.rear };
+}
+
+/** A place as stored: the cat's own name too (sent with spare cats). */
+type KeptPlace = CatPlace & { name: string };
+
+const WORD = /^[\w-]{1,64}$/;
+const PHASES = new Set(['walking', 'using', 'elevator', 'idle']);
+const finite = (n: unknown): n is number => typeof n === 'number' && Number.isFinite(n);
+/** A short line of text: at most `max` characters, no control characters. */
+const text = (v: unknown, max: number): v is string => typeof v === 'string' && v.length <= max && [...v].every((c) => c.charCodeAt(0) >= 0x20);
+
+function readPlace(v: unknown, at: number): KeptPlace | null {
+  if (!v || typeof v !== 'object' || Array.isArray(v)) return null;
+  const p = v as Record<string, unknown>;
+  const act = p.activity as { kind?: unknown; label?: unknown } | null | undefined;
+  if (!Number.isInteger(p.floor) || !finite(p.u) || !finite(p.v)) return null;
+  if (!text(p.catId, 64) || !CAT.test(p.catId) || !text(p.name, 64)) return null;
+  if (![p.direction, p.state, p.gesture, p.expression].every((w) => typeof w === 'string' && WORD.test(w))) return null;
+  if (typeof p.asleep !== 'boolean' || typeof p.phase !== 'string' || !PHASES.has(p.phase)) return null;
+  if (act !== null && (!act || typeof act !== 'object' || !text(act.kind, 64) || !WORD.test(act.kind) || !text(act.label, 80))) return null;
+  if (p.spotId !== null && !(text(p.spotId, 128) && p.spotId.length > 0)) return null;
+  if (p.minutesLeft !== null && !finite(p.minutesLeft)) return null;
+  if (p.ridingTo !== null && !Number.isInteger(p.ridingTo)) return null;
+  return {
+    name: p.name,
+    catId: p.catId,
+    floor: p.floor as number,
+    u: p.u,
+    v: p.v,
+    direction: p.direction as string,
+    state: p.state as string,
+    gesture: p.gesture as string,
+    expression: p.expression as string,
+    asleep: p.asleep,
+    activity: act ? { kind: act.kind as string, label: act.label as string } : null,
+    spotId: p.spotId,
+    minutesLeft: p.minutesLeft,
+    phase: p.phase as CatPlace['phase'],
+    ridingTo: p.ridingTo as number | null,
+    at,
+  };
+}
+
+const sameDesk = (a: AgentDesk | undefined, b: AgentDesk): boolean => !!a && a.id === b.id && a.flip === b.flip && a.rear === b.rear;
+
+export class CatAssignmentStore {
+  private cats = new Map<string, string>();
+  private desks = new Map<string, AgentDesk>();
+  /** Place key (agent id, or `spare:<sim id>`) → its newest place; in memory only. */
+  private places = new Map<string, KeptPlace>();
+  /** When places last went out to the stream (server clock). */
+  private placesSent = -Infinity;
+  /** The page whose places are kept, and when it last posted (server clock). */
+  private following: { page: string; last: number } | null = null;
+  private listeners = new Set<ChangeListener>();
+  readonly file: string;
+
+  constructor(file: string) {
+    this.file = file;
+    this.load();
+  }
+
+  onChange(fn: ChangeListener): () => void {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+
+  get(id: string): string | null {
+    return this.cats.get(id) ?? null;
+  }
+
+  /**
+   * Takes the page's `{ assignments?: { [agentId]: catId }, desks?: { [agentId]: { desk, flip, rear } },
+   * places?: { [agentId | "spare:<sim id>"]: place }, at?, page? }` (`at`, epoch ms, required with places, at most 5 s
+   * ahead of `now`; `page`, the posting page's id, made once per page load). False for a bad body (nothing kept) or
+   * a failed save. A malformed place is skipped; per cat the newest `at` wins. Only the followed page's places are
+   * kept (the first page that posted, until it is silent 5 s). Places go out to the stream when they changed (`at`
+   * aside), and at least every 5 s.
+   */
+  merge(body: unknown, now: number = Date.now()): boolean {
+    const b = body as { assignments?: unknown; desks?: unknown; places?: unknown; at?: unknown; page?: unknown } | null;
+    if (!b || (b.assignments === undefined && b.desks === undefined && b.places === undefined)) return false;
+    const isMap = (v: unknown): v is Record<string, unknown> => !!v && typeof v === 'object' && !Array.isArray(v);
+    if (b.assignments !== undefined && !isMap(b.assignments)) return false;
+    if (b.desks !== undefined && !isMap(b.desks)) return false;
+    if (b.places !== undefined && (!isMap(b.places) || !finite(b.at) || b.at > now + PLACE_AHEAD_MS)) return false;
+    if (b.page !== undefined && !(typeof b.page === 'string' && ID.test(b.page))) return false;
+    const cats = Object.entries((b.assignments ?? {}) as Record<string, unknown>);
+    if (!cats.every(([id, cat]) => ID.test(id) && typeof cat === 'string' && CAT.test(cat))) return false;
+    const desks = Object.entries((b.desks ?? {}) as Record<string, unknown>).map(([id, v]) => [id, readDesk(v)] as const);
+    if (!desks.every(([id, desk]) => ID.test(id) && desk !== null)) return false;
+    let changed = false;
+    for (const [id, cat] of cats as [string, string][]) {
+      if (this.cats.get(id) === cat) continue;
+      this.cats.delete(id); // re-inserted last: the newest
+      this.cats.set(id, cat);
+      changed = true;
+    }
+    for (const [id, desk] of desks as (readonly [string, AgentDesk])[]) {
+      if (sameDesk(this.desks.get(id), desk)) continue;
+      this.desks.delete(id);
+      this.desks.set(id, desk);
+      changed = true;
+    }
+    while (this.cats.size > KEEP_MAX) this.cats.delete(this.cats.keys().next().value as string);
+    while (this.desks.size > KEEP_MAX) this.desks.delete(this.desks.keys().next().value as string);
+    const placed = b.places === undefined || !this.follows((b.page as string | undefined) ?? '', now) ? 'none' : this.mergePlaces(b.places as Record<string, unknown>, b.at as number, now);
+    const moved = placed === 'changed' || (placed === 'same' && now - this.placesSent >= PLACE_HEARTBEAT_MS);
+    if (!changed && !moved) return true;
+    if (moved) this.placesSent = now;
+    if (changed) {
+      try {
+        this.save();
+      } catch {
+        return false;
+      }
+    }
+    for (const fn of this.listeners) {
+      try {
+        fn();
+      } catch {
+        // A broken listener must not stop the others.
+      }
+    }
+    return true;
+  }
+
+  /** Whether `page`'s places are kept: it is the followed page, or there is none, or that one has gone silent. */
+  private follows(page: string, now: number): boolean {
+    const f = this.following;
+    if (f && f.page !== page && now - f.last < PAGE_SILENT_MS) return false;
+    this.following = { page, last: now };
+    return true;
+  }
+
+  /**
+   * Keeps the places newer than what is kept for each cat: 'changed' when a kept one differs (`at` aside) or one
+   * was dropped, 'same' when only times moved on, 'none' when nothing was kept.
+   */
+  private mergePlaces(places: Record<string, unknown>, at: number, now: number): 'changed' | 'same' | 'none' {
+    let kept = false;
+    let differs = false;
+    if (now - at <= PLACE_MAX_AGE_MS) {
+      for (const [key, v] of Object.entries(places)) {
+        if (!ID.test(key) && !SPARE.test(key)) continue;
+        const place = readPlace(v, at);
+        const had = this.places.get(key);
+        if (!place || (had && had.at > at)) continue;
+        if (!had || !samePlace(had, place)) differs = true;
+        this.places.delete(key); // re-inserted last: the newest
+        this.places.set(key, place);
+        kept = true;
+      }
+    }
+    for (const [key, p] of this.places) {
+      if (now - p.at <= PLACE_MAX_AGE_MS) continue;
+      this.places.delete(key);
+      differs = true;
+    }
+    while (this.places.size > PLACES_MAX) {
+      this.places.delete(this.places.keys().next().value as string);
+      differs = true;
+    }
+    return differs ? 'changed' : kept ? 'same' : 'none';
+  }
+
+  /**
+   * The snapshot with each agent's cat, desk and place, for the agents the page has reported them for; plus the
+   * spare cats' places (`spares`) and the newest place's time (`placesAt`, null without any). Only the latest
+   * round shows (within 5 s of the newest): a spare since claimed, or a session whose cat was taken, leaves no
+   * ghost. Places over 60 s old are left out.
+   */
+  apply(snapshot: AgentSnapshot, now: number = Date.now()): AgentSnapshot {
+    let placesAt: number | null = null;
+    for (const p of this.places.values()) if (now - p.at <= PLACE_MAX_AGE_MS) placesAt = Math.max(placesAt ?? p.at, p.at);
+    const fresh = (p: KeptPlace | undefined): p is KeptPlace => !!p && placesAt !== null && now - p.at <= PLACE_MAX_AGE_MS && p.at >= placesAt - PLACE_ROUND_MS;
+    const spares: SparePlace[] = [];
+    for (const [key, p] of this.places) if (fresh(p) && SPARE.test(key)) spares.push({ ...p, key });
+    return {
+      ...snapshot,
+      agents: snapshot.agents.map((a) => {
+        const cat = this.cats.get(a.id);
+        const desk = this.desks.get(a.id);
+        const kept = this.places.get(a.id);
+        const place = fresh(kept) ? withoutName(kept) : undefined;
+        return cat || desk || place ? { ...a, ...(cat ? { cat } : {}), ...(desk ? { desk } : {}), ...(place ? { place } : {}) } : a;
+      }),
+      spares,
+      placesAt,
+    };
+  }
+
+  private load(): void {
+    try {
+      const d = JSON.parse(readFileSync(this.file, 'utf8')) as { cats?: Record<string, unknown>; desks?: Record<string, unknown> };
+      for (const [id, cat] of Object.entries(d.cats ?? {})) {
+        if (ID.test(id) && typeof cat === 'string' && CAT.test(cat)) this.cats.set(id, cat);
+      }
+      for (const [id, v] of Object.entries(d.desks ?? {})) {
+        const desk = readDesk(v);
+        if (ID.test(id) && desk) this.desks.set(id, desk);
+      }
+    } catch {
+      // None yet (or unreadable): start empty.
+    }
+  }
+
+  private save(): void {
+    mkdirSync(dirname(this.file), { recursive: true });
+    const tmp = `${this.file}.tmp`;
+    writeFileSync(tmp, JSON.stringify({ cats: Object.fromEntries(this.cats), desks: Object.fromEntries(this.desks) }, null, 2) + '\n');
+    renameSync(tmp, this.file);
+  }
+}
+
+/** The same place, whenever it was posted. */
+function samePlace(a: KeptPlace, b: KeptPlace): boolean {
+  const { at: _a, ...x } = a;
+  const { at: _b, ...y } = b;
+  return JSON.stringify(x) === JSON.stringify(y);
+}
+
+function withoutName(p: KeptPlace): CatPlace {
+  const { name: _name, ...place } = p;
+  return place;
+}
+
+/**
+ * Writes `{ url, token, dir, pid }` to `file` (owner-only: it holds the token) for local apps to find the bridge
+ * and Cat Office's folder. Returns a remover that deletes it, unless another server has written its own since.
+ */
+export function writeBridgeInfo(file: string, info: { url: string; token: string; dir: string }): () => void {
+  mkdirSync(dirname(file), { recursive: true });
+  const tmp = `${file}.tmp`;
+  writeFileSync(tmp, JSON.stringify({ url: info.url, token: info.token, dir: info.dir, pid: process.pid }) + '\n', { mode: 0o600 });
+  chmodSync(tmp, 0o600);
+  renameSync(tmp, file);
+  return () => {
+    try {
+      const d = JSON.parse(readFileSync(file, 'utf8')) as { pid?: unknown };
+      if (d.pid === process.pid) rmSync(file);
+    } catch {
+      // Already gone.
+    }
+  };
+}
