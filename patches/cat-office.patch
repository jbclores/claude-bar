+/**
+ * Saves an office worker's `rate_limit_event` (its `rate_limit_info.unifiedWindows`, utilization 0..1 and reset
+ * times in epoch seconds) to `path` in the status line's format. False, and nothing written, when it carries no
+ * usable window or the file can't be written.
+ */
+export function savePlanFromRateLimit(info: unknown, sessionId: string | null, path = PLAN_FILE, now = Date.now()): boolean {
+  const windows = (info as { unifiedWindows?: unknown } | null)?.unifiedWindows;
+  if (!windows || typeof windows !== 'object') return false;
+  const limits: Record<string, { used_percentage: number; resets_at?: number }> = {};
+  for (const key of ['five_hour', 'seven_day'] as const) {
+    const w = (windows as Json)[key];
+    if (!w || typeof w !== 'object') continue;
+    const { utilization, resetsAt } = w as Json;
+    if (typeof utilization !== 'number' || !Number.isFinite(utilization)) continue;
+    limits[key] = {
+      used_percentage: Math.round(Math.min(1, Math.max(0, utilization)) * 1000) / 10,
+      ...(typeof resetsAt === 'number' && Number.isFinite(resetsAt) && resetsAt > 0 ? { resets_at: resetsAt } : {}),
+    };
+  }
+  if (Object.keys(limits).length === 0) return false;
+  try {
+    mkdirSync(dirname(path), { recursive: true });
+    const tmp = `${path}.${process.pid}.tmp`;
+    writeFileSync(tmp, JSON.stringify({ at: now, session_id: sessionId, source: 'office-worker', rate_limits: limits }));
+    renameSync(tmp, path);
+    return true;
+  } catch {
+    return false;
+  }
